{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "types": ["jasmine"]
  },
  "include": [
    "**/*.spec.ts"
  ],
  "exclude": [],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  },
}
